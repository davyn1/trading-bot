# Copy this file to .env and fill in your keys. Never commit .env.
#
# Get keys at https://app.alpaca.markets — log in, switch the account picker
# (top left) to "Paper", then Home -> API Keys -> Generate. Paper keys only
# work against the paper endpoint, which is what the bot uses by default
# (PAPER = True in config.py).

ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXX
ALPACA_SECRET_KEY=your-secret-key-here

# Discord webhook URL for morning_briefing.py (Server Settings -> Integrations
# -> Webhooks -> New Webhook -> Copy Webhook URL). Optional; the script skips
# posting if unset.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
